# Contact form target. Any endpoint that accepts a JSON POST works —
# Web3Forms and Formspree are both drop-in. Leave empty to run the site
# without a working form (the UI degrades to a mailto link).
VITE_CONTACT_ENDPOINT=https://api.web3forms.com/submit

# Public access key of the contact provider. This is meant to be public and
# ships in the client bundle — never put a private API key here.
VITE_CONTACT_ACCESS_KEY=
